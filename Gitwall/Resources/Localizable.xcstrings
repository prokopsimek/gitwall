{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ items match now" : {
      "comment" : "Header of the preset editor for a preset that has a count. The argument is the number, as in 12 or 1000+."
    },
    "%@+" : {
      "comment" : "The count of a preset whose search stopped at the provider's cap, as in 1000+. The argument is the number."
    },
    "Fetching “%@”…" : {
      "comment" : "Accessibility label and tooltip of the spinner of a preset's list while the preset is being fetched. The argument is the preset's name."
    },
    "Fetching…" : {
      "comment" : "Header of the preset editor, beside a spinner, while a preset that was never fetched is being fetched."
    },
    "Not fetched yet" : {
      "comment" : "Tooltip of a preset's count, shown as a dash, while the preset was never fetched. Also the header of the preset editor for such a preset."
    },
    "Query failed" : {
      "comment" : "A preset whose search the provider refused: its count, the tooltip, the footer of the popover and the main window, a wall tile and a widget."
    },
    "Query failed · updated %@" : {
      "comment" : "Tooltip of a preset whose last search was refused. The argument says when its last result was fetched, as in 5 min ago."
    },
    "Updated %@" : {
      "comment" : "Tooltip of a preset's count. The argument says when the preset was fetched, as in 5 min ago."
    },
    "Waiting for sync" : {
      "comment" : "A widget or wall tile of a preset that was never fetched. Also the title of the popover's and the main window's list for it."
    },
    "This preset has not been fetched yet." : {
      "comment" : "Message of the list of a preset that was never fetched, while no fetch runs."
    },
    "The provider refused this preset's query, so nothing was fetched. Check the query in Settings › Presets or try again." : {
      "comment" : "Message of the list of a preset whose query was refused before it was ever fetched."
    },
    "Try Again" : {
      "comment" : "Button of the list of a preset that was never fetched, which fetches it now."
    }
  },
  "version" : "1.0"
}
